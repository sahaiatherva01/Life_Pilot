# LifePilot Environment Configuration

# Database (PostgreSQL)
# Local PostgreSQL default on macOS: postgresql+asyncpg://sahaiatherva@localhost:5432/lifepilot
# Or Docker default: postgresql+asyncpg://postgres:postgres@localhost:5432/lifepilot
DATABASE_URL=postgresql+asyncpg://sahaiatherva@localhost:5432/lifepilot

# Master PIN / Security
MASTER_PIN=1234
JWT_SECRET=lifepilot_super_secret_jwt_key_change_in_production_2026
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=43200

# Assistant (Orion)
OLLAMA_BASE_URL=http://localhost:11434
ORION_MODEL=qwen2.5:3b-instruct

# Timezone
TIMEZONE=Asia/Kolkata

# Briefing Times
BRIEFING_MORNING=07:00
BRIEFING_NIGHT=23:30

# CORS
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","capacitor://localhost","http://localhost"]
