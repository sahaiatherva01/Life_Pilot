# Copy to .env and fill in. Never commit .env.
APP_ENV=development
TIMEZONE=Asia/Kolkata

DATABASE_URL=postgresql+psycopg://lifepilot:change-me@localhost:5432/lifepilot
REDIS_URL=redis://localhost:6379/0

SECRET_KEY=change-me
TOKEN_ENCRYPTION_KEY=change-me

# Orion local runtime (e.g. Ollama)
ORION_RUNTIME_URL=http://localhost:11434
ORION_MODEL=change-me

# Google Calendar (create an OAuth client in Google Cloud)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/calendar/google/callback

# Web push (VAPID)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
